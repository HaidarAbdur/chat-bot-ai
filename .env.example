# Template Konfigurasi Environment Variable Chatbot AI
# Salin file ini menjadi .env lalu isi API key Groq kamu:
# cp .env.example .env

# Google Gemini API Key (Dapatkan di https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Nama Model Groq (Opsional, default: llama-3.3-70b-versatile)
MODEL_NAME=gemini-3.6-flash

# System Prompt Persona (Opsional, default: gemini-2.5-flash)
# SYSTEM_PROMPT=Kamu adalah asisten AI yang ramah, cerdas, dan sopan.
